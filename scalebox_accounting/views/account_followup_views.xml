<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_at_followup_level_list" model="ir.ui.view">
        <field name="name">at.followup.level.list</field>
        <field name="model">at.followup.level</field>
        <field name="arch" type="xml">
            <list string="Follow-up Levels" editable="bottom">
                <field name="delay"/>
                <field name="name"/>
                <field name="subject"/>
                <field name="send_email"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_at_followup_level_form" model="ir.ui.view">
        <field name="name">at.followup.level.form</field>
        <field name="model">at.followup.level</field>
        <field name="arch" type="xml">
            <form string="Follow-up Level">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. First Reminder"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="delay"/>
                            <field name="send_email"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="body" placeholder="Message shown above the list of overdue invoices..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_at_followup_level" model="ir.actions.act_window">
        <field name="name">Follow-up Levels</field>
        <field name="res_model">at.followup.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your reminder levels</p>
            <p>
                Each level triggers once a partner's oldest overdue invoice
                passes the number of days you set.
            </p>
        </field>
    </record>

    <record id="view_partner_form_at_followup" model="ir.ui.view">
        <field name="name">res.partner.form.at.followup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Payment Follow-up"
                       groups="account.group_account_readonly">
                    <field name="at_followup_currency_id" invisible="1"/>
                    <field name="at_followup_level_id"/>
                    <field name="at_followup_amount_due"/>
                    <field name="at_followup_next_date"/>
                    <button name="action_at_send_followup" type="object"
                            string="Send Reminder" class="btn-secondary"
                            invisible="not at_followup_level_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_at_followup_level"
              name="Follow-up Levels"
              parent="account.menu_finance_configuration"
              action="action_at_followup_level"
              sequence="90"/>

</odoo>
