<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_post_depreciation" model="ir.cron">
        <field name="name">AT Accounting: Post Due Depreciation</field>
        <field name="model_id" ref="model_at_account_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_depreciation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Present in 17 (removed in 19); the default of 1 would run the job
             once and never again, so -1 for no limit. -->
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
