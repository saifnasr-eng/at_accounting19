<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_header_block">
        <div class="text-center">
            <h2><span t-esc="title"/></h2>
            <h4><span t-field="docs.company_id.name"/></h4>
        </div>
        <div class="row mt-3 mb-3">
            <div class="col-3">
                <strong>From:</strong> <span t-field="docs.date_from"/>
            </div>
            <div class="col-3">
                <strong>To:</strong> <span t-field="docs.date_to"/>
            </div>
            <div class="col-3">
                <strong>Entries:</strong>
                <span t-if="docs.target_move == 'posted'">Posted only</span>
                <span t-else="">All</span>
            </div>
            <div class="col-3">
                <strong>Currency:</strong> <span t-field="currency.name"/>
            </div>
        </div>
        <div t-if="docs.journal_ids" class="mb-2">
            <strong>Journals:</strong>
            <span t-esc="', '.join(docs.journal_ids.mapped('code'))"/>
        </div>
    </template>

    <template id="report_trial_balance_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-call="at_account_accountant.report_header_block">
                    <t t-set="title">Trial Balance</t>
                </t>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Account</th>
                            <th class="text-end">Initial Balance</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                            <th class="text-end">Closing Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line">
                            <td><span t-esc="line['code']"/></td>
                            <td><span t-esc="line['name']"/></td>
                            <td class="text-end">
                                <span t-esc="line['opening']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['debit']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['credit']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['closing']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                        <tr t-if="not lines">
                            <td colspan="6" class="text-center">
                                No entries match these options.
                            </td>
                        </tr>
                    </tbody>
                    <tfoot t-if="lines">
                        <tr class="border-black o_total">
                            <td colspan="2"><strong>Total</strong></td>
                            <td class="text-end">
                                <strong t-esc="totals['opening']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <strong t-esc="totals['debit']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <strong t-esc="totals['credit']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                            <td class="text-end">
                                <strong t-esc="totals['closing']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

    <template id="report_trial_balance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="at_account_accountant.report_trial_balance_document"/>
            </t>
        </t>
    </template>

    <template id="report_general_ledger_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-call="at_account_accountant.report_header_block">
                    <t t-set="title">General Ledger</t>
                </t>

                <t t-foreach="accounts" t-as="account_data">
                    <h5 class="mt-4">
                        <span t-esc="account_data['code']"/> —
                        <span t-esc="account_data['name']"/>
                    </h5>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Entry</th>
                                <th>Journal</th>
                                <th>Partner</th>
                                <th>Label</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="7"><em>Initial Balance</em></td>
                                <td class="text-end">
                                    <span t-esc="account_data['opening']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr t-foreach="account_data['entries']" t-as="entry">
                                <td><span t-esc="entry['date']"/></td>
                                <td><span t-esc="entry['move_name']"/></td>
                                <td><span t-esc="entry['journal']"/></td>
                                <td><span t-esc="entry['partner']"/></td>
                                <td><span t-esc="entry['label']"/></td>
                                <td class="text-end">
                                    <span t-esc="entry['debit']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="entry['credit']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="entry['running_balance']"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="border-black o_total">
                                <td colspan="5"><strong>Total</strong></td>
                                <td class="text-end">
                                    <strong t-esc="account_data['debit']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <strong t-esc="account_data['credit']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <strong t-esc="account_data['closing']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <p t-if="not accounts" class="text-center">
                    No entries match these options.
                </p>
            </div>
        </t>
    </template>

    <template id="report_general_ledger">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="at_account_accountant.report_general_ledger_document"/>
            </t>
        </t>
    </template>

</odoo>
